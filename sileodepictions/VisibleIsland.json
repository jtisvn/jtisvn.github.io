{
"markdown": "### VisibleIsland\n\nA fresh and simple way to enable and customize the Dynamic Island on older models below iPhone 14 Pro.\n\nCompatible with devices running iOS 16 and later.",
"useSpacing": false,
"class": "DepictionMarkdownView"
},
{
"class": "DepictionScreenshotsView",
"screenshots": [
{
"url": "https://jtisvn.github.io/infodeb/VisibleIsland/Screenshots/1.png",
"accessibilityText": "Screenshot 1"
},
