{
"markdown": "### Evo Center\n\nBring a modern, iOS 18-style Control Center experience to older iOS versions.",
"useSpacing": false,
"class": "DepictionMarkdownView"
},
{
"class": "DepictionScreenshotsView",
"screenshots": [
{
"url": "https://eleveny123.github.io/EvoCenter/assets/screenshots/1.jpg",
"accessibilityText": "Screenshot 1"
},
{
