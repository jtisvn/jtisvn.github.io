{
"markdown": "### Liquidify\n\nBrings an elegant, modern and crystal-clear Liquid Glass effect to your entire iOS interface.",
"useSpacing": false,
"class": "DepictionMarkdownView"
},
{
"class": "DepictionScreenshotsView",
"screenshots": [
{
"url": "https://jtisvn.github.io/infodeb/Liquidify/Screenshots/1.png",
"accessibilityText": "Screenshot 1"
},
{
"url": "https://jtisvn.github.io/infodeb/Liquidify/Screenshots/2.png",
"accessibilityText": "Screenshot 2"
},
{
"url": "https://jtisvn.github.io/infodeb/Liquidify/Screenshots/3.png",
