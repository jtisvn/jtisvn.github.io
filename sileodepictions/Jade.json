{
"markdown": "### Jade\n\nA tweak that revives your Control Center, allowing deep customization and adding new features.",
"useSpacing": false,
"class": "DepictionMarkdownView"
},
{
"class": "DepictionScreenshotsView",
"screenshots": [
{
"url": "https://jtisvn.github.io/infodeb/Jade/Screenshots/1.png",
"accessibilityText": "Screenshot 1"
},
{
"url": "https://jtisvn.github.io/infodeb/Jade/Screenshots/2.png",
"accessibilityText": "Screenshot 2"
},
{
"url": "https://jtisvn.github.io/infodeb/Jade/Screenshots/3.png",
"accessibilityText": "Screenshot 3"
},
{
"url": "https://jtisvn.github.io/infodeb/Jade/Screenshots/4.png",
