{
"markdown": "### DockBeauty\n\nA powerful tweak to customize and beautify your iOS Dock, bringing dynamic animations, stunning light streams, and deep personalization to make your Home Screen unique.",
"useSpacing": false,
"class": "DepictionMarkdownView"
},
{
"class": "DepictionScreenshotsView",
"screenshots": [
{
"url": "https://jtisvn.github.io/infodeb/DockBeauty/Screenshots/1.png",
"accessibilityText": "Screenshot 1"
},
{
"url": "https://jtisvn.github.io/infodeb/DockBeauty/Screenshots/2.png",
"accessibilityText": "Screenshot 2"
},
{
"url": "https://jtisvn.github.io/infodeb/DockBeauty/Screenshots/3.png",
